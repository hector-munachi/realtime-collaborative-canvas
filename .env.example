NEXT_PUBLIC_SYNC_URL=ws://localhost:1234
NEXT_PUBLIC_SYNC_HTTP_URL=http://localhost:1234
SYNC_PORT=1234
SYNC_DATA_DIR=./data
SYNC_AUTH_SECRET=replace-with-a-long-random-secret
SYNC_ALLOWED_ORIGINS=http://localhost:3001
SYNC_REPLAY_RETENTION_DAYS=30
SYNC_REPLAY_MAX_ENTRIES=20000
SYNC_RATE_LIMIT_PER_MINUTE=120
# Optional: separate durable backup mount and protected metrics endpoint.
SYNC_BACKUP_DIR=./data/backups
SYNC_METRICS_KEY=replace-with-a-second-random-secret
